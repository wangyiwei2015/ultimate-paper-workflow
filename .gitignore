latexmkrc-*
# REVTeX writes the footnote pseudo-bibliography here on every BibTeX pass
*Notes.bib

# Final paper (rebuild with: make paper)
/latex_paper/main.pdf

# Journal-template demos (rebuild with: make examples)
/latex_paper/example_*.pdf

# MATLAB
matlab/*.asv
matlab/*.m~
matlab/**/slprj/

# Editors / OS
.vscode/settings.json
.DS_Store
Thumbs.db

# code.cmd (VS Code CLI) dumps its stderr here when run non-interactively,
# e.g. "code --install-extension" from setup/windows.ps1
/debug.log
